{
	"name": "df_customer_bronze",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_customer_landing",
						"type": "DatasetReference"
					},
					"name": "srcCustomer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_customer_reject",
						"type": "DatasetReference"
					},
					"name": "snkCustomerReject"
				},
				{
					"dataset": {
						"referenceName": "ds_customer_bronze",
						"type": "DatasetReference"
					},
					"name": "snkCustomerBronze"
				}
			],
			"transformations": [
				{
					"name": "selValidateSchema"
				},
				{
					"name": "drvAuditColumns"
				},
				{
					"name": "csValidInvalid"
				}
			],
			"scriptLines": [
				"parameters{",
				"     batch_id as string",
				"}",
				"source(output(",
				"          address as string,",
				"          city as string,",
				"          created_date as string,",
				"          customer_id as string,",
				"          customer_status as string,",
				"          date_of_birth as string,",
				"          email as string,",
				"          first_name as string,",
				"          gender as string,",
				"          last_name as string,",
				"          last_updated_ts as string,",
				"          phone_number as string,",
				"          state as string,",
				"          zip_code as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> srcCustomer",
				"srcCustomer select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selValidateSchema",
				"selValidateSchema derive(ingestion_ts = currentUTC(),",
				"          batch_id = $batch_id,",
				"          debug_customer_id_null = isNull(customer_id),",
				"          debug_first_name_null = isNull(first_name),",
				"          debug_customer_id = customer_id,",
				"          debug_first_name = first_name) ~> drvAuditColumns",
				"drvAuditColumns split(isNull(customer_id)",
				"|| isNull(first_name)",
				"|| isNull(last_name)",
				"|| isNull(email),",
				"     true(),",
				"     disjoint: false) ~> csValidInvalid@(RejectedRecords, ValidRecords)",
				"csValidInvalid@RejectedRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> snkCustomerReject",
				"csValidInvalid@ValidRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> snkCustomerBronze"
			]
		}
	}
}