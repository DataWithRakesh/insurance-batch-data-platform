		"cells": [
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql.functions import col,count,lit,current_date,row_number\n",
					"from pyspark.sql.window import Window"
				],
				"execution_count": 1
			},
			{
				"cell_type": "code",
				"source": [
					"df=spark.read.parquet(\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/bronze/insurance_claims.parquet\")\n",
					"print(df.count())\n",
					"df.printSchema()"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"print(df.columns)"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"policy_df=df.select(\n",
					"    \"policy_number\",\n",
					"    \"policy_bind_date\",\n",
					"    \"policy_csl\",\n",
					"    \"policy_state\",\n",
					"    \"policy_deductable\",\n",
					"    \"policy_annual_premium\",\n",
					"    \"umbrella_limit\"\n",
					"\n",
					")\n",
					"\n",
					"policy_df.write.format('delta').mode('overwrite').save(\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\")\n",
					""
				],
				"execution_count": 7
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"policy_delta_df= spark.read.format(\"delta\").load(\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\")\n",
					"print(policy_delta_df.count())\n",
					"display(policy_delta_df.limit(5))"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"policy_scd2_df=policy_delta_df.withColumn(\"policy_sk\",row_number().over(Window.orderBy(\"policy_number\")))\\\n",
					"                    .withColumn(\"effective_start_date\",current_date())\\\n",
					"                    .withColumn(\"effective_end_date\",lit(\"9999-12-31\"))\\\n",
					"                    .withColumn(\"is_current\",lit(\"Y\"))"
				],
				"execution_count": 12
			},
			{
				"cell_type": "code",
				"source": [
					"policy_scd2_df.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\",\"true\").save(\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\")\n",
					""
				],
				"execution_count": 16
			},
			{
				"cell_type": "code",
				"source": [
					"spark.read.format(\"delta\").load(\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\").printSchema()\n",
					""
				]
			},
			{
				"cell_type": "code",
				"source": [
					"from delta.tables import DeltaTable\n",
					"silver_path=\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\"\n",
					"DeltaTable.isDeltaTable(spark,silver_path)"
				],
				"execution_count": 19
			}
		]
	}
