					"from pyspark.sql import SparkSession\n",
					"from pyspark.sql import functions as F"
				],
				"execution_count": 33
			},
			{
				"cell_type": "code",
				"source": [
					"spark = SparkSession.builder.getOrCreate()\n",
					"\n",
					"jdbc_url=\"jdbc:sqlserver://sql-ibdp-dev.database.windows.net:1433;database=control-db\"\n",
					"\n",
					"connection_properties ={\n",
					"    \"user\":\"sqladmin\",\n",
					"    \"password\":\"Magic@21\",\n",
					"    \"driver\":\"com.microsoft.sqlserver.jdbc.SQLServerDriver\"\n",
					"}"
				],
				"execution_count": 34
			},
			{
				"cell_type": "code",
				"source": [
					"metadata_df = (\n",
					"    spark.read.jdbc(url=jdbc_url,\n",
					"                    table=\"metadata\",\n",
					"                    properties =connection_properties\n",
					"                    )\n",
					")\n",
					"\n",
					"metadata_df.show(5,truncate=False)\n",
					""
				],
				"execution_count": 35
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"def get_metadata(source_name):\n",
					"    return (\n",
					"        metadata_df\n",
					"        .filter(F.col(\"source_name\")==source_name)\n",
					"        .first()\n",
					"    )"
				],
				"execution_count": 37
			},
			{
				"cell_type": "code",
				"source": [
					"def get_source_path(source_name):\n",
					"    return(get_metadata(source_name).source_path)"
				],
				"execution_count": 38
			},
			{
				"cell_type": "code",
				"source": [
