{
	"name": "pl_customer_silver",
	"properties": {
		"activities": [
			{
				"name": "nb_customer_silver",
				"type": "SynapseNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "nb_customer_silver",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparksmall",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"conf": {
						"spark.dynamicAllocation.enabled": true,
						"spark.dynamicAllocation.minExecutors": 1,
						"spark.dynamicAllocation.maxExecutors": 2
					},
					"driverSize": "Small",
					"numExecutors": 1,
					"authentication": {
						"type": "MSI"
					}
				}
			},
			{
				"name": "sp_update_watermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "nb_customer_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_update_watermark]",
					"storedProcedureParameters": {
						"last_watermark_value": {
							"value": {
								"value": "@json(activity('nb_customer_silver').output.result.exitValue).new_watermark",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"source_name": {
							"value": {
								"value": "@json(activity('nb_customer_silver').output.result.exitValue).source_name",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			}
		],
		"folder": {
			"name": "pipelines/silver/customer"
		},
		"annotations": []
	}
}