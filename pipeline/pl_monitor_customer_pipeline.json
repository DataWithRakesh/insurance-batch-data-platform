{
	"name": "pl_monitor_customer_pipeline",
	"properties": {
		"activities": [
			{
				"name": "lk_latest_pipeline_run",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT TOP 1\n    run_id,\n    pipeline_name,\n    status,\n    start_time,\n    end_time,\n    error_message\nFROM dbo.pipeline_run\nWHERE pipeline_name = 'pl_customer_landing_to_bronze'\nORDER BY start_time DESC;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_metadata",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "lk_latest_pipeline_run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('lk_latest_pipeline_run').output.firstRow.status,'Success')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "web_send_email_alert",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"headers": {
									"Content-Type": "application/json"
								},
								"url": "https://prod-00.westus2.logic.azure.com:443/workflows/42141f3328904764a6f5138773f759d0/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=UCVSJjiWlqOoWOwtcO8PdlGeX9KNxMqae1FhsRaoZOg",
								"connectVia": {
									"referenceName": "AutoResolveIntegrationRuntime",
									"type": "IntegrationRuntimeReference"
								},
								"body": {
									"value": "{\n  \"pipeline_name\": \"@{activity('lk_latest_pipeline_run').output.firstRow.pipeline_name}\",\n  \"run_id\": \"@{activity('lk_latest_pipeline_run').output.firstRow.run_id}\",\n  \"status\": \"@{activity('lk_latest_pipeline_run').output.firstRow.status}\",\n  \"start_time\": \"@{activity('lk_latest_pipeline_run').output.firstRow.start_time}\",\n  \"end_time\": \"@{activity('lk_latest_pipeline_run').output.firstRow.end_time}\",\n  \"error_message\": \"@{activity('lk_latest_pipeline_run').output.firstRow.error_message}\"\n}",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "pipelines/monitoring"
		},
		"annotations": []
	}
}