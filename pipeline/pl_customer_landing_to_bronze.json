{
	"name": "pl_customer_landing_to_bronze",
	"properties": {
		"activities": [
			{
				"name": "lkp_customer_metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT *\nFROM metadata\nWHERE source_name = 'customer'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "nb_customer_bronze_load",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "lkp_customer_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "nb_customer_bronze",
						"type": "NotebookReference"
					},
					"parameters": {
						"source_name": {
							"value": {
								"value": "@activity('lkp_customer_metadata').output.firstRow.source_name",
								"type": "Expression"
							},
							"type": "string"
						},
						"landing_path": {
							"value": {
								"value": "@activity('lkp_customer_metadata').output.firstRow.source_path",
								"type": "Expression"
							},
							"type": "string"
						},
						"bronze_path": {
							"value": "@activity('lkp_customer_metadata').output.firstRow.bronze_path",
							"type": "string"
						},
						"file_format": {
							"value": "@activity('lkp_customer_metadata').output.firstRow.file_format",
							"type": "string"
						}
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparksmall",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"conf": {
						"spark.dynamicAllocation.enabled": true,
						"spark.dynamicAllocation.minExecutors": 2,
						"spark.dynamicAllocation.maxExecutors": 2
					},
					"driverSize": "Small",
					"numExecutors": 2,
					"authentication": {
						"type": "MSI"
					}
				}
			}
		],
		"folder": {
			"name": "customer"
		},
		"annotations": []
	}
}