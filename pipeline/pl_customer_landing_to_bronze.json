{
	"name": "pl_customer_landing_to_bronze",
	"properties": {
		"activities": [
			{
				"name": "lkp_customer_metadata",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "sp_insert_pipeline_run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT *\nFROM metadata\nWHERE source_name = 'customer'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "df_customer_bronze_load",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "lkp_customer_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_customer_bronze",
						"type": "DataFlowReference",
						"parameters": {
							"batch_id": {
								"value": "'@{pipeline().RunId}'",
								"type": "Expression"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "gm_customer_landing_files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "set_records_rejected_after_df",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_customer_landing",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "fe_archive_customer_files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "gm_customer_landing_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('gm_customer_landing_files').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "cp_archive_customer_file",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "if_csv_file",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_customer_file_binary",
									"type": "DatasetReference",
									"parameters": {
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_customer_archive",
									"type": "DatasetReference",
									"parameters": {
										"file_name": "@item().name",
										"archive_folder": {
											"value": "@concat('archive/customer/', formatDateTime(utcNow(),'yyyy-MM-dd'))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "del_landing_file",
							"type": "Delete",
							"dependsOn": [
								{
									"activity": "cp_archive_customer_file",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_customer_file_binary",
									"type": "DatasetReference",
									"parameters": {
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						},
						{
							"name": "if_csv_file",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@endsWith(item().name, '.csv')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "sp_insert_pipeline_run",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "set_records_rejected",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_insert_pipeline_run]",
					"storedProcedureParameters": {
						"batch_date": {
							"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
							"type": "DateTime"
						},
						"error_message": {
							"value": "",
							"type": "String"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"start_time": {
							"value": "@utcNow()",
							"type": "DateTime"
						},
						"status": {
							"value": "RUNNING",
							"type": "String"
						},
						"triggered_by": {
							"value": "Manual",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_update_pipeline_run_success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "fe_archive_customer_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_update_pipeline_run]",
					"storedProcedureParameters": {
						"end_time": {
							"value": "@utcNow()",
							"type": "DateTime"
						},
						"error_message": {
							"value": "",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"status": {
							"value": "SUCCESS",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_update_pipeline_run_failed",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "fe_archive_customer_files",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_update_pipeline_run]",
					"storedProcedureParameters": {
						"end_time": {
							"value": "@utcNow()",
							"type": "DateTime"
						},
						"error_message": {
							"value": {
								"value": "@activity('fe_archive_customer_files').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"status": {
							"value": "FAILED",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_insert_error_log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "sp_update_pipeline_run_failed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_insert_error_log]",
					"storedProcedureParameters": {
						"batch_date": {
							"value": {
								"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"error_message": {
							"value": "@activity('fe_archive_customer_files').error.message",
							"type": "String"
						},
						"error_timestamp": {
							"value": "@utcNow()",
							"type": "DateTime"
						},
						"layer": {
							"value": "Bronze",
							"type": "String"
						},
						"notebook_name": {
							"value": "",
							"type": "String"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"source_name": {
							"value": "customer",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_insert_audit_log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "set_duration_seconds",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_insert_audit_log]",
					"storedProcedureParameters": {
						"batch_date": {
							"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
							"type": "DateTime"
						},
						"duration_seconds": {
							"value": "@variables('v_duration_seconds')",
							"type": "Int32"
						},
						"end_time": {
							"value": "@utcNow()",
							"type": "DateTime"
						},
						"layer": {
							"value": "Bronze",
							"type": "String"
						},
						"records_read": {
							"value": "@variables('v_records_read')",
							"type": "Int32"
						},
						"records_rejected": {
							"value": "@variables('v_records_rejected')",
							"type": "Int32"
						},
						"records_written": {
							"value": "@variables('v_records_written')",
							"type": "Int32"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"source_name": {
							"value": "customer",
							"type": "String"
						},
						"start_time": {
							"value": "@variables('v_start_time')",
							"type": "DateTime"
						},
						"status": {
							"value": "SUCCESS",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_slq_server",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "set_start_time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_start_time",
					"value": "@utcNow()"
				}
			},
			{
				"name": "set_records_read",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_start_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_read",
					"value": 0
				}
			},
			{
				"name": "set_records_written",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_records_read",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_written",
					"value": 0
				}
			},
			{
				"name": "set_records_rejected",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_records_written",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_rejected",
					"value": 0
				}
			},
			{
				"name": "set_records_read_after_df",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "df_customer_bronze_load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_read",
					"value": 1000
				}
			},
			{
				"name": "set_records_written_after_df",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_records_read_after_df",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_written",
					"value": 1000
				}
			},
			{
				"name": "set_records_rejected_after_df",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_records_written_after_df",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_records_rejected",
					"value": 0
				}
			},
			{
				"name": "set_duration_seconds",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "sp_update_pipeline_run_success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_duration_seconds",
					"value": "@div(sub(ticks(utcNow()),ticks(variables('v_start_time'))),10000000)"
				}
			}
		],
		"variables": {
			"v_start_time": {
				"type": "String"
			},
			"v_records_read": {
				"type": "Integer"
			},
			"v_records_written": {
				"type": "Integer"
			},
			"v_records_rejected": {
				"type": "Integer"
			},
			"v_duration_seconds": {
				"type": "Integer"
			}
		},
		"folder": {
			"name": "customer"
		},
		"annotations": []
	}
}